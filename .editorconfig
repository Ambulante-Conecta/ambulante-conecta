# Padrão de formatação do projeto (VS Code: instale a extensão "EditorConfig for VS Code")
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# schema.sql vem do pg_dump, que indenta com 4 espaços
[*.sql]
indent_size = 4

# Em Markdown, dois espaços no fim da linha forçam a quebra de linha
[*.md]
trim_trailing_whitespace = false
