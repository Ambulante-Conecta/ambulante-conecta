# Copie para .env e preencha. Nunca versione o .env.

# --- Banco local (desenvolvimento) ---
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASSWORD=
DB_NAME=seu_banco

# --- Banco publicado (Neon): se existir, substitui as variáveis DB_* acima ---
# DATABASE_URL=postgresql://usuario:senha@endereco.neon.tech/banco?sslmode=require

PORT=3000

# Só no desenvolvimento: limite de logins a cada 15 minutos (padrão 20). O npm test faz uns 16 logins por execução,
# então rodar a suíte duas vezes seguidas estoura o limite. Com 200 dá para repetir à vontade. Ignorado em produção.
LOGIN_LIMITE=200

# Mínimo de 32 caracteres. Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Só no serviço publicado (Render) ---
# NODE_ENV=production
# Endereço do front no GitHub Pages (sem barra no fim), separado por vírgula se houver mais de um
# CORS_ORIGINS=https://ambulante-conecta.github.io
